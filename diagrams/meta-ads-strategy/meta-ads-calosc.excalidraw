      "type": "text",
      "x": 2460,
      "y": 1126,
      "width": 1100,
      "height": 17,
      "text": "Co PLN realnie psuje:",
      "rawText": "Co PLN realnie psuje:",
      "originalText": "Co PLN realnie psuje:",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
