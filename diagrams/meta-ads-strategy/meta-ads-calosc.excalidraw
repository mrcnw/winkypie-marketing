      "locked": false,
      "type": "text",
      "x": 125,
      "y": 668,
      "width": 520,
      "height": 30,
      "text": "10–30 zestawów, 1–2 kreacje w każdym — żeby „czysto zmierzyć\"\npojedynczy wariant.",
      "rawText": "10–30 zestawów, 1–2 kreacje w każdym — żeby „czysto zmierzyć\"\npojedynczy wariant.",
