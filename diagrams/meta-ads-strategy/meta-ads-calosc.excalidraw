      "type": "text",
      "x": 705,
      "y": 668,
      "width": 520,
      "height": 30,
      "text": "1 kampania, 1 zestaw, 10–20+ kreacji naraz. Meta: do 50 zasobów\njednorazowo, bez limitu reklam. [T1]",
      "rawText": "1 kampania, 1 zestaw, 10–20+ kreacji naraz. Meta: do 50 zasobów\njednorazowo, bez limitu reklam. [T1]",
