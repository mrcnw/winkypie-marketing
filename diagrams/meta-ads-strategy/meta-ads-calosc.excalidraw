      "height": 44
    },
    {
      "id": "t0000162",
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2040385149,
      "version": 1,
      "versionNonce": 222805627,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
