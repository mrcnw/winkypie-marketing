      "x": 2988,
      "y": 1598.3,
      "width": 964,
      "height": 28,
      "text": "Meta o kampaniach aplikacyjnych, dosłownie: „we suggest selecting the lowest cost bid\ntype and NOT adding a bid cap for best results\". [M8]",
      "rawText": "Meta o kampaniach aplikacyjnych, dosłownie: „we suggest selecting the lowest cost bid\ntype and NOT adding a bid cap for best results\". [M8]",
