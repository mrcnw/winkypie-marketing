      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 2078,
      "y": 4060.3,
      "width": 1874,
      "height": 28,
      "text": "Meta, dosłownie: „an ad set becomes learning limited when it is unlikely to receive about 50 optimization events IN THE WEEK after your last significant edit.\" [M9]\nTydzień — nie dzień. Zestaw — nie kampania i nie pojedyncza reklama. Licznik startuje od ostatniej istotnej edycji, a każda taka edycja zeruje go od nowa.",
      "rawText": "Meta, dosłownie: „an ad set becomes learning limited when it is unlikely to receive about 50 optimization events IN THE WEEK after your last significant edit.\" [M9]\nTydzień — nie dzień. Zestaw — nie kampania i nie pojedyncza reklama. Licznik startuje od ostatniej istotnej edycji, a każda taka edycja zeruje go od nowa.",
      "originalText": "Meta, dosłownie: „an ad set becomes learning limited when it is unlikely to receive about 50 optimization events IN THE WEEK after your last significant edit.\" [M9]\nTydzień — nie dzień. Zestaw — nie kampania i nie pojedyncza reklama. Licznik startuje od ostatniej istotnej edycji, a każda taka edycja zeruje go od nowa.",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25
    },
